<?xml version="1.0" encoding="utf-8"?>
<!-- §9.4: exclude WebView data directory and cookie databases from backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="WebView" />
        <exclude domain="root" path="Databases" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="WebView" />
        <exclude domain="root" path="Databases" />
    </device-transfer>
</data-extraction-rules>
