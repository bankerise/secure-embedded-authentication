<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Bottom-sheet Activity theme (§18.1). Transparent window + slide animations. -->
    <style name="SEA.AuthSheetTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/SEA.AuthSheetAnimation</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <!--
        Never repaint the status/nav bars: this Activity is a translucent
        overlay on top of the host app (§18.1), not a distinct screen.
        Without this, Theme.MaterialComponents.Light's own default status
        bar color/appearance briefly replaces the host app's real one the
        moment this Activity opens, then has to visually snap back on
        finish() — that mismatch is what reads as "the status bar changes"
        on open and an ugly transition on dismiss. Transparent here means
        there is nothing to repaint, so the host app's own status bar just
        keeps showing through unchanged the entire time.
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="SEA.AuthSheetAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/sea_slide_up</item>
        <item name="android:windowExitAnimation">@anim/sea_slide_down</item>
    </style>

</resources>
