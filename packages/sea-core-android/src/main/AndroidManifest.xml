<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- API 36+: required to call Activity.registerScreenCaptureCallback -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <application>
        <!--
            §9.1: The auth surface Activity. Launched explicitly by SEASession
            via Intent — no intent-filter needed for the normal embedded path.
            The callback-scheme intent-filter enables the fallback path (§10.4)
            where an external browser redirects back to the app.
        -->
        <activity
            android:name="com.bankerise.sea.core.SEAAuthActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/SEA.AuthSheetTheme">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${seaCallbackScheme}"
                    android:host="callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
